# Camera list (copy cameras.example.yaml to cameras.yaml)
CV_CONFIG=cameras.yaml
CV_HOST=0.0.0.0
CV_PORT=8001
# URL the dashboard's browser uses to reach this service (for snapshot/stream links)
CV_PUBLIC_URL=http://localhost:8001
# Comma-separated origins allowed to call the API (the Vite dev server)
CV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# YOLO weights (downloaded on first run) and device: mps (Apple GPU) or cpu
CV_MODEL=yolov8n.pt
CV_DEVICE=mps
# Minimum detection score to count a person
CV_CONF=0.4
# Seconds between detections per camera (tracking needs several per second)
CV_INFER_EVERY_S=0.1
# A tracked person must be seen in this many detections to be counted
CV_MIN_TRACK_HITS=3
# A pass along the line ends after this many seconds with nobody in view
CV_PASS_GAP_S=5
# A camera with no frame for this long is reported offline
CV_OFFLINE_AFTER_S=10
